# Copy to .env for local runs. On Hugging Face Spaces, add these as Space secrets instead.

# Public URL of this API (used in evidence packs and MCP metadata)
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# Supabase: Project Settings -> API / Database
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for projects that still sign sessions with the legacy HS256 secret
SUPABASE_JWT_SECRET=
# Use the Session pooler connection string (IPv4), port 5432
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Gemini free tier: https://aistudio.google.com/apikey  (leave empty to run without the assistant)
GEMINI_API_KEY=

# Vision: "speciesnet" (real model) or "mock" (fast fake detections for development)
VISION_BACKEND=speciesnet
ADMIN1_REGION=GJ

# Evidence signing key: python -m app.evidence keygen
EVIDENCE_SIGNING_KEY=

# Optional: Telegram alerts (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional: WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Protects POST /v1/kb/ingest
ADMIN_TOKEN=
