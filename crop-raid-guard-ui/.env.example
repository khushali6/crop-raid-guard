# Supabase project (Settings → API). The publishable/anon key is safe to expose in the browser;
# Row Level Security protects every table.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Crop Raid Guard API (Hugging Face Space), without a trailing slash.
VITE_API_URL=https://YOUR-USER-crop-raid-guard-api.hf.space
